{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "makam/makam-app",
    "type": "project",
    "description": "Makam.co.id — Indonesian end-of-life services platform.",
    "keywords": ["laravel", "makam", "funeral", "cemetery"],
    "license": "proprietary",
    "require": {
        "php": "~8.5.0",
        "endroid/qr-code": "^6.1",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.0",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "lint": "pint --test",
        "analyse": "phpstan analyse",
        "test": "@php artisan test",
        "verify:docs": "bash ci/verify-docs.sh",
        "verify:contrast": "python3 docs/design/verify-contrast.py"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
