# Environment
.env
.env.*
!.env.*.example
# `.env.*` above also matches `.env.example`, and `!.env.*.example` does not
# rescue it (that pattern needs a segment between the dots, e.g. .env.dev.example).
# The template MUST be tracked — it is the only non-secret record of which
# variables exist. Found 25 Jul 2026 when the Laravel scaffold landed and the
# skeleton's .env.example silently disappeared from git's view.
!.env.example

# Laravel
.phpunit.result.cache
/.phpunit.cache
auth.json

# Secrets
*.pem
*.key
secrets/
*_password*.txt
*_token*.txt

# Dependencies (future app code)
vendor/
node_modules/

# Build artifacts
public/build/
storage/*.key
bootstrap/cache/*.php

# OS/editor
.DS_Store
.idea/
.vscode/

# Project-specific expectations (stakeholder MVP, not code)
ekspektasi-user

# Agent config (per AGENTS.md M-3)
.claude/

# Reversed 25 Jul 2026: this line un-ignores ekspektasi-user despite the
# blanket ignore above. Reasoning recorded in the commit message and in
# docs/planning/ekspektasi-vs-specs.md §4 D5 — it is the stakeholder-MVP
# expectation document, authority rank 2 under AGENTS.md, and its being
# untracked broke CI (GATE 4: a link to it 404s on a clean checkout).
!ekspektasi-user
