# Larastan configuration.
# ci-cd-and-release.md §2 requires a static analysis stage.
#
# ARCH-12 (batch M5c, 7 Sep 2026): the previous comment here said level was
# "kept low deliberately — this is a scaffold with almost no application
# code yet." That was true once but had gone stale — this is now a mature,
# feature-rich Laravel/Filament codebase (1,740+ PHP files at the time of
# this fix), not a scaffold, and the stale comment was actively misleading
# about why the level was low. It was also missing `tests` from `paths`
# entirely, so 706 of 1,740 PHP files (all of `tests/`) got zero static
# analysis.
#
# Real, current state: level 5 with `baseline.neon` capturing every
# pre-existing level-5 violation across `app` and `tests` as of this fix,
# so CI enforces level 5 on every LINE CHANGED from here on without
# requiring the whole backlog to be fixed in one PR. Ratcheting further
# (level 6+, and shrinking the baseline) is expected future work, not done
# here — this batch fixed only the "free" issues the finding called out by
# name (five dead `catch` blocks, one missing `match` arm that was a real
# `UnhandledMatchError` bug) and left everything else in the baseline
# untouched.
includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app
        - tests

    level: 5

    # Larastan's ModelCastHelper defaults this to false (extension.neon) and
    # falls back to reading a model's `casts(): array` method by its
    # declared return type only (e.g. `array<string, string>`), never the
    # literal keys/values inside the method body — so every cast declared
    # via this codebase's own `protected function casts(): array` convention
    # (14 models, e.g. OutboxEvent's `occurred_at => immutable_datetime`)
    # was invisible to it, producing false positives like "Cannot call
    # method toRfc3339String() on string" for a genuinely CarbonImmutable
    # attribute. This flag makes Larastan parse the method body's actual
    # return expression instead. Verified against the real installed
    # larastan/larastan v3.10.0 source (src/Properties/ModelCastHelper.php)
    # on the sibling host, not guessed.
    parseModelCastsMethod: true

    excludePaths:
        - app/Domain/*/README.md
        - app/Platform/README.md
