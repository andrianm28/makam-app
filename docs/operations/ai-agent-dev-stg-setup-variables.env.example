# Non-secret input variables for the AI-agent setup prompt.
# Copy values into the agent session or protected orchestration environment.
# Do not add passwords, tokens, APP_KEY values, private keys, or provider secrets.

REPOSITORY_URL=
DEPLOYMENT_USER=deploy
DEPLOYMENT_ROOT=/opt/makam
DEV_DOMAIN=dev.makam.co.id
STG_DOMAIN=stg.makam.co.id
ALLOWED_DEV_IPS=
CONTAINER_REGISTRY=
S3_DEV_BUCKET_OR_PREFIX=
S3_STG_BUCKET_OR_PREFIX=
ERROR_TRACKING_PROVIDER=

# Optional execution controls
AGENT_CAN_SSH=false
AGENT_CAN_WRITE_REPOSITORY=true
AGENT_CAN_MODIFY_DNS=false
AGENT_CAN_ACCESS_PROVIDER_SANDBOX=false
AGENT_REQUIRES_HUMAN_APPROVAL_FOR_DESTRUCTIVE_ACTIONS=true
